{
  "permissions": {
    "allow": [
      "Bash(dotnet build)", "Bash(dotnet build *)",
      "Bash(dotnet test)", "Bash(dotnet test *)",
      "Bash(dotnet restore)", "Bash(dotnet restore *)",
      "Bash(dotnet ef *)",
      "Bash(dotnet --list-sdks)", "Bash(dotnet --version)",
      "Bash(node --version)", "Bash(npm --version)", "Bash(docker --version)",
      "Bash(npm ci)", "Bash(npm run *)",
      "Bash(git status)", "Bash(git status *)",
      "Bash(git diff)", "Bash(git diff *)",
      "Bash(git log *)", "Bash(git show *)", "Bash(git add *)",
      "Bash(docker compose config)", "Bash(docker compose config *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(dotnet add *)", "Bash(dotnet new *)",
      "Bash(npm install *)",
      "Bash(docker compose up *)", "Bash(docker build *)"
    ],
    "deny": [
      "Bash(git push)", "Bash(git push *)",
      "Bash(git merge *)", "Bash(git rebase *)",
      "Bash(git reset --hard *)", "Bash(git checkout -- *)",
      "Bash(rm -rf *)"
    ]
  }
}
